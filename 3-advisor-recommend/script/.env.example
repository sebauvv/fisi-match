# Modo de ejecucion: local | cloud
MODE=local

# DB local (Docker)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=advisors_db
DB_USER=advisor_user
DB_PASSWORD=advisor_local_pass

# DB cloud (RDS) - descomentar para usar
# DB_HOST=your-rds-endpoint.us-east-2.rds.amazonaws.com
# DB_PORT=5432
# DB_PASSWORD=your_rds_password

# AWS
AWS_REGION=us-east-2
AWS_PROFILE=Ecomm-Seba

# Modelo de embeddings (Bedrock Titan v2)
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# Modelo de lenguaje para explicaciones RAG (Nova Lite)
LLM_MODEL=us.amazon.nova-lite-v1:0

# Recomendacion
TOP_K=5
RECENCY_BOOST=0.3
CHUNKS_PER_ADVISOR=10
KNN_LIMIT=50
