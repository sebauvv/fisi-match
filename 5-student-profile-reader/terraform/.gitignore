# Local .terraform directories (contains provider binaries and modules)
**/.terraform/*

# .tfstate files (contains sensitive data and infrastructure secrets)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (likely to contain sensitive data like passwords/keys)
*.tfvars
*.tfvars.json

# Ignore override files (used for local-only modifications)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files (can contain secrets in plain text)
*tfplan*
/package
lambda.zip